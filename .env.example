DATABASE_URL=postgresql://user:password@host:5432/dbname
# 管理員：建議用 ADMIN_DISCORD_IDS（你的 Discord ID，逗號分隔），用 Discord 登入就是管理員
ADMIN_DISCORD_IDS=
# 選填：管理員密碼登入。不設就關閉密碼登入
# ADMIN_PASSWORD=
SESSION_SECRET=long-random-string

# Discord 登入（Discord Developer Portal → 你的 bot 應用程式 → OAuth2）
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 選填，預設用目前網址 + /auth/discord/callback
# DISCORD_REDIRECT_URI=https://你的網域/auth/discord/callback

# 選填
# GUILD_ID=              只讓這些伺服器的成員登入（逗號分隔），不填就用資料庫裡出現過的伺服器
# DEFAULT_GUILD_ID=      新增紀錄時預設的伺服器
# TIMEZONE=Asia/Taipei
# DEV_LOGIN=1            本機測試用，登入頁可直接選使用者，Railway 上不能開
# SOURCE_DATABASE_URL=   本機用 scripts/pull_prod_data.py 複製正式資料時的來源（Railway 的 DATABASE_PUBLIC_URL）
